---
graph TD;
	__start__([<p>__start__</p>]):::first
	inicializar(inicializar)
	ingesta(ingesta)
	analizar(analizar)
	puntuar(puntuar)
	router(router)
	despachar(despachar)
	alerta_interna(alerta_interna)
