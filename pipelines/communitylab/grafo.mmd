	alerta_interna -.-> consolidacion;
	alerta_interna -.-> despachar;
	analizar -.-> consolidacion;
	analizar -.-> puntuar;
	despachar -.-> alerta_interna;
	despachar -.-> consolidacion;
	despachar -.-> generador_faq_tip;
	despachar -.-> generador_highlights;
	despachar -.-> generador_post_linkedin_x;
	generador_faq_tip -.-> consolidacion;
	generador_faq_tip -.-> despachar;
	generador_highlights -.-> consolidacion;
	generador_highlights -.-> despachar;
	generador_post_linkedin_x -.-> consolidacion;
	generador_post_linkedin_x -.-> despachar;
	ingesta -.-> analizar;
	ingesta -.-> consolidacion;
	inicializar --> ingesta;
	puntuar -.-> consolidacion;
	puntuar -.-> router;
	router -.-> consolidacion;
	router -.-> despachar;
	consolidacion --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
