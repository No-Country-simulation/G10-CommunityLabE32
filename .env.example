POSTGRES_DB=communitylab
POSTGRES_USER=communitylab
# Definir un secreto propio en .env; nunca subir .env.
POSTGRES_PASSWORD=
DOCKER_PLATFORM=linux/arm64
# PC Intel/AMD sin emulación: DOCKER_PLATFORM=linux/amd64
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# simulado no llama a proveedores externos; gemini usa IA real (requiere clave y modelos).
WORKER_MODE=simulado
# Debe ser ≥ GEMINI_PRESUPUESTO_SEGUNDOS + 10 (el worker no arranca si no).
WORKER_TIMEOUT=300
# Modo gemini: la clave solo en .env privado. Modelos en orden de escalamiento (rápido,escalado);
# verificar su disponibilidad en el proyecto antes de usarlos (ver docs/gemini-grafo-worker.md).
GEMINI_API_KEY=
GEMINI_MODELOS=
# Valores probados en la VM con la cuenta gratuita de Gemini (unas 15 llamadas por minuto): una semana
# completa usa 16-19 llamadas, así que el lote espera lo que pide un 429 por ritmo en vez de cortarse.
# Debe caber en WORKER_TIMEOUT con 10 s de margen.
GEMINI_PRESUPUESTO_SEGUNDOS=240
GEMINI_MAX_LLAMADAS=24
GEMINI_REINTENTOS=2
GEMINI_ESPERA_MAXIMA=60
# Acciones protegidas (procesar pendientes, aprobar textos, generar/revisar banners).
# Valores largos y aleatorios, solo en .env privado. Vacío = acción deshabilitada (503).
OPERADOR_TOKEN=
# Puente Discord -> API para «Procesar pendientes». Vacío = solo cierre semanal.
PUENTE_TOKEN=

# --- OCI Object Storage (copia de los activos aprobados; ver backend/app/services/oci.py) ---
# instance_principal: la VM se autentica con su identidad (grupo dinámico + política), sin llaves.
# Cualquier otro valor no llama a OCI. No pongas llaves de OCI en este archivo.
OCI_ALMACENAMIENTO=desactivado
OCI_BUCKET_NAME=communitylab-activos-marketing
OCI_NAMESPACE=
